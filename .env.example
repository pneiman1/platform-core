# platform-core environment configuration template
# Copy this file to .env and fill in real values. Never commit .env.

# === Environment ===
ENVIRONMENT=dev
LOG_LEVEL=INFO

# === Snowflake ===
# Account format: <orglocator>-<accountname> e.g. kyhyqgt-rk09884
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Keypair auth (preferred): Snowflake enforces MFA on password auth,
# which cannot complete headless. See dermiq docs/DECISIONS.md ADR-009.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fallback only; unused while SNOWFLAKE_PRIVATE_KEY_PATH is set.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DERMIQ

# === LLM provider ===
# Set to 'anthropic' for direct API (dev) or 'bedrock' for AWS Bedrock (prod with PHI)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
# Only used if LLM_PROVIDER=bedrock
BEDROCK_REGION=us-west-2

# === Embeddings ===
# Set to 'voyage' for higher quality (requires API key) or 'sentence_transformers' for free local
EMBEDDING_PROVIDER=sentence_transformers
VOYAGE_API_KEY=

# === Application database ===
DATABASE_URL=postgresql://dermiq:dermiq@localhost:5432/dermiq
PGVECTOR_DIMENSIONS=384

# === PHI / tenant security ===
PHI_REDACTION_MODE=strict
# Generate a random salt for each deployment: openssl rand -hex 32
TOKENIZATION_SALT=CHANGE-ME-IN-PRODUCTION

# === Feature flags ===
ENABLE_RAG=true
ENABLE_FORECASTING=true

# === Local dev defaults ===
DEFAULT_TENANT_ID=del_mar
